{
  "name": "teachback-webmcp",
  "version": "0.1.0",
  "private": true,
  "description": "Human-governed playbook creation and reuse through WebMCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hayashiii-ghub/teachback-webmcp.git"
  },
  "homepage": "https://teachback-webmcp.haygsiiii.chatgpt.site/",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.13"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "tsc -b && vinext build",
    "preview": "vinext start --port 4173",
    "render:brand": "bun scripts/render-brand-assets.ts",
    "render:youtube": "bun scripts/render-brand-assets.ts youtube-v2",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:public": "TEACHBACK_E2E_PUBLIC=1 playwright test",
    "check": "bun run test && bun run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vinext": "1.0.0-beta.9",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
