{
  "name": "teachback-webmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vinext dev",
    "build": "tsc -b && vinext build",
    "preview": "vinext start --port 4173",
    "render:brand": "bun scripts/render-brand-assets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:public": "TEACHBACK_E2E_PUBLIC=1 playwright test",
    "check": "bun run test && bun run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vinext": "1.0.0-beta.3",
    "vitest": "4.1.11",
    "wrangler": "4.92.0"
  }
}
